# =============================================================
# .env.example — copie para .env e ajuste as senhas
# NUNCA commite o .env real no repositório!
# =============================================================

# PostgreSQL
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=ecommerce
AIRFLOW_DB=airflow_db

# pgAdmin
PGADMIN_EMAIL=admin@pipeline.dev
PGADMIN_PASSWORD=sua_senha_aqui

# Airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=sua_senha_aqui
AIRFLOW_EMAIL=admin@pipeline.dev

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=gere_sua_chave_aqui
AIRFLOW_SECRET_KEY=gere_sua_chave_aqui
