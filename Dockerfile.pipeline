# Container Python para scripts do pipeline (gerador, processamento, ML)
FROM python:3.12-slim

WORKDIR /app

# Dependências do sistema (necessário para psycopg2 e compilação)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo o projeto
COPY . .

# Comando padrão: mantém o container vivo para rodar comandos avulsos
CMD ["tail", "-f", "/dev/null"]